#!/usr/bin/env sh

LRCLIB_INSTANCE="https://lrclib.net"

status() {
    printf '%s\n' "$2" >&2
    if [ -n "${PID:-}" ]; then
        rmpc remote --pid "$PID" status "$2" --level "$1" || true
    fi
}

index_lrc() {
    if [ -n "${PID:-}" ]; then
        rmpc remote --pid "$PID" indexlrc --path "$LRC_FILE"
    fi
}

[ "${HAS_LRC:-false}" = "true" ] && exit 0

if [ -z "${LRC_FILE:-}" ] || [ -z "${ARTIST:-}" ] || [ -z "${TITLE:-}" ]; then
    status error "Lyrics download requires LRC_FILE, ARTIST and TITLE from rmpc's song-change hook"
    exit 1
fi

# A previous download may not have been indexed by this rmpc instance yet.
if [ -s "$LRC_FILE" ]; then
    index_lrc
    exit $?
fi

if ! mkdir -p "$(dirname "$LRC_FILE")"; then
    status error "Cannot create lyrics directory for $LRC_FILE"
    exit 1
fi
if ! TEMP_FILE=$(mktemp "$LRC_FILE.XXXXXX"); then
    status error "Cannot create temporary lyrics file for $LRC_FILE"
    exit 1
fi
trap 'rm -f "$TEMP_FILE"' 0
trap 'exit 1' HUP INT TERM

set -- --data-urlencode "artist_name=$ARTIST" --data-urlencode "track_name=$TITLE"
if [ -n "${ALBUM:-}" ]; then
    set -- "$@" --data-urlencode "album_name=$ALBUM"
fi
# rmpc exports M:SS or H:MM:SS, while LRCLIB requires numeric seconds.
# Also accept seconds directly, and omit unrecognized formats rather than send a 400.
DURATION_SECONDS=$(printf '%s\n' "${DURATION:-}" | awk -F: '
    /^[0-9]+([.][0-9]+)?$/ { print; next }
    /^[0-9]+:[0-9]{2}(:[0-9]{2})?([.][0-9]+)?$/ {
        if ($NF >= 60 || (NF == 3 && $2 >= 60)) next
        seconds = 0
        for (i = 1; i <= NF; i++) seconds = seconds * 60 + $i
        printf "%.9g\n", seconds
    }
')
if [ -n "$DURATION_SECONDS" ]; then
    set -- "$@" --data-urlencode "duration=$DURATION_SECONDS"
fi

# Capture curl's status separately so HTTP/network errors cannot become LRC files.
if ! HTTP_CODE=$(curl --silent --show-error --location --get \
    --connect-timeout 5 --max-time 20 --retry 2 \
    --header "Lrclib-Client: rmpc-${VERSION:-unknown}" \
    --output "$TEMP_FILE" --write-out '%{http_code}' \
    "$@" "$LRCLIB_INSTANCE/api/get"); then
    status error "Failed to download lyrics for $ARTIST - $TITLE"
    exit 1
fi
case "$HTTP_CODE" in
    200) ;;
    404)
        status warn "Lyrics for $ARTIST - $TITLE not found"
        exit 0
        ;;
    *)
        status error "Lyrics download failed (HTTP $HTTP_CODE) for $ARTIST - $TITLE"
        exit 1
        ;;
esac

if ! LYRICS=$(jq -r '.syncedLyrics // empty' "$TEMP_FILE"); then
    status error "Invalid lyrics response for $ARTIST - $TITLE"
    exit 1
fi
# rmpc needs synchronized lyrics; plainLyrics alone cannot be displayed.
if ! printf '%s\n' "$LYRICS" | grep -Eq '^\[[0-9]+:[0-9]{2}([.][0-9]+)?\]'; then
    status warn "Synchronized lyrics for $ARTIST - $TITLE not found"
    exit 0
fi

# Write matching MPD metadata and publish only the complete LRC file.
if ! {
    printf '[ar:%s]\n[al:%s]\n[ti:%s]\n' "$ARTIST" "${ALBUM:-}" "$TITLE" &&
    printf '%s\n' "$LYRICS" | sed -E '/^\[(ar|al|ti):/d'
} >"$TEMP_FILE" || ! mv -f "$TEMP_FILE" "$LRC_FILE"; then
    status error "Failed to save lyrics to $LRC_FILE"
    exit 1
fi

if ! index_lrc; then
    status error "Saved lyrics, but failed to refresh them in rmpc"
    exit 1
fi
status info "Downloaded lyrics for $ARTIST - $TITLE"
